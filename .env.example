# Gemini powers chat, speech recognition and spoken replies (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-3.8-flash
# Real-time voice conversation (Gemini Live). LIVE_MODE=off uses the record-then-reply voice loop instead.
LIVE_MODE=on
LIVE_MODEL=gemini-3.8-live
# Speech-to-text and text-to-speech models (typed replies and LIVE_MODE=off)
GEMINI_ASR_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Voice for spoken replies, e.g. Charon, Puck, Kore, Fenrir, Orus, Aoede
GEMINI_TTS_VOICE=Charon
# Live answers (weather, news, prices) via Google Search grounding: on/off
GEMINI_SEARCH=on

# Optional wake word: when set, hands-free only answers phrases containing it (e.g. jarvis)
WAKE_WORD=

# Voice provider: auto (Fish Audio if FISH_API_KEY is set, otherwise Gemini), gemini, or fish
VOICE_PROVIDER=auto
# Optional Fish Audio voice instead of Gemini
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_VOICE_ID=

PORT=3000

# Tools that may run without asking (comma-separated), e.g. type_text,press_keys. Leave blank to always ask for risky actions.
AUTO_APPROVE=

# Optional second brains. Jarvis keeps Gemini as the default and can also ask Claude or ChatGPT.
# Claude key from https://platform.claude.com (API use is billed separately from a Claude subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# ChatGPT key from https://platform.openai.com (API use is billed separately from ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# When Gemini reaches its limit, Claude or ChatGPT answers instead, and voice uses OpenAI speech (needs OPENAI_API_KEY)
OPENAI_ASR_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
# Live voice with ChatGPT (pick it in Controller, or it takes over when Gemini Live runs out)
OPENAI_LIVE_MODEL=gpt-realtime
OPENAI_LIVE_VOICE=cedar
